# ==============================================================================
# DOZO / HELPER PLATFORM - PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION & DATABASE
# ------------------------------------------------------------------------------
NODE_ENV="production"
PORT=3000
REALTIME_PORT=3001

# PostgreSQL connection string (Supabase, Neon, AWS RDS, or self-hosted)
DATABASE_URL="postgresql://user:password@localhost:5432/helper_platform?sslmode=require"
# Optional separate database connections if segregating schemas
DATABASE_URL_WEB="postgresql://user:password@localhost:5432/helper_platform_web?sslmode=require"
DATABASE_URL_REALTIME="postgresql://user:password@localhost:5432/helper_platform_realtime?sslmode=require"

# Redis connection string (Upstash, AWS ElastiCache, or Redis Cloud)
REDIS_URL="redis://default:password@localhost:6379"

# ------------------------------------------------------------------------------
# 2. BETTER AUTH & APPLICATION SECRETS
# ------------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="https://yourdomain.com"
AUTH_SECRET="" # Can match BETTER_AUTH_SECRET

# Symmetric AES-256 encryption key for sensitive bank payout details (IFSC, Account Number)
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=""

# Secret for Cron API routes (/api/cron/doc-expiry, /api/cron/resume-matching)
# Generate with: openssl rand -hex 32
CRON_SECRET=""

# ------------------------------------------------------------------------------
# 3. REALTIME WEBSOCKET & OPS INGRESS
# ------------------------------------------------------------------------------
CORS_ORIGIN="https://yourdomain.com"
REALTIME_BASE_URL="https://realtime.yourdomain.com"
NEXT_PUBLIC_REALTIME_HTTP_BASE_URL="https://realtime.yourdomain.com"
NEXT_PUBLIC_REALTIME_WS_URL="wss://realtime.yourdomain.com/api/realtime/ws"

# Shared HMAC secret for WebSocket client authentication tokens & internal broadcast ops
# Generate with: openssl rand -hex 32
REALTIME_WS_AUTH_SECRET=""
REALTIME_BROADCAST_SECRET=""

# ------------------------------------------------------------------------------
# 4. MAPPING & LIVE ROUTING (100% FREE - ZERO API KEYS NEEDED)
# ------------------------------------------------------------------------------
# Note: The platform uses MapLibre GL + OpenFreeMap Vector Basemaps + OpenStreetMap Nominatim
# + Project OSRM Turn-by-Turn Road Routing. They are 100% free and require NO API keys.
# Optional: Self-hosted OSRM backend endpoint (defaults to public Project OSRM router)
NEXT_PUBLIC_OSRM_BASE_URL="https://router.project-osrm.org"

# ------------------------------------------------------------------------------
# 5. RAZORPAY PAYMENT GATEWAY
# ------------------------------------------------------------------------------
# Obtain from Razorpay Dashboard (Settings -> API Keys & Webhooks)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# ------------------------------------------------------------------------------
# 6. CLOUDINARY (MEDIA & DOCUMENT STORAGE)
# ------------------------------------------------------------------------------
# Obtain from Cloudinary Dashboard -> Settings -> Access Keys
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
NEXT_PUBLIC_CLOUDINARY_PRESET="helper_documents"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ------------------------------------------------------------------------------
# 7. EMAIL NOTIFICATIONS (RESEND)
# ------------------------------------------------------------------------------
# Obtain from Resend Dashboard -> API Keys & Domains
RESEND_API_KEY=""
RESEND_FROM_EMAIL="support@yourdomain.com"
FROM_EMAIL="support@yourdomain.com"

# ------------------------------------------------------------------------------
# 8. WEB PUSH NOTIFICATIONS (VAPID)
# ------------------------------------------------------------------------------
# Generate VAPID key pair with: npx web-push generate-vapid-keys
NEXT_PUBLIC_WEB_PUSH_VAPID_PUBLIC_KEY=""
WEB_PUSH_VAPID_PRIVATE_KEY=""
WEB_PUSH_CONTACT_EMAIL="admin@yourdomain.com"

# ------------------------------------------------------------------------------
# 9. OAUTH PROVIDERS (LOGIN WITH GOOGLE & GITHUB)
# ------------------------------------------------------------------------------
# Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# GitHub Developer Settings -> OAuth Apps
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ------------------------------------------------------------------------------
# 10. GOOGLE CALENDAR & VIDEO KYC AUTOMATION
# ------------------------------------------------------------------------------
# Google Cloud Service Account with Google Calendar API enabled
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""
GOOGLE_KYC_CALENDAR_ID=""
VIDEO_KYC_FALLBACK_MEETING_BASE_URL="https://meet.jit.si"
KYC_ADMIN_EMAIL="kyc@yourdomain.com"
KYC_ADMIN_CALENDAR_MAP='{"kyc@yourdomain.com":"primary"}'
VIDEO_KYC_HOST_EMAIL="kyc@yourdomain.com"
VIDEO_KYC_TIMEZONE="Asia/Kolkata"
VIDEO_KYC_TIMEZONE_OFFSET="+05:30"
VIDEO_KYC_START_HOUR_LOCAL=10
VIDEO_KYC_END_HOUR_LOCAL=18
VIDEO_KYC_SLOT_INTERVAL_MINUTES=15
VIDEO_KYC_DURATION_MINUTES=20
VIDEO_KYC_MIN_LEAD_MINUTES=60
VIDEO_KYC_DAYS_AHEAD=7
VIDEO_KYC_JOIN_NOT_BEFORE_MINUTES=10
VIDEO_KYC_JOIN_NOT_AFTER_MINUTES=15

# ------------------------------------------------------------------------------
# 11. FEATURE FLAGS
# ------------------------------------------------------------------------------
ENABLE_EMAIL_VERIFICATION=true
ENABLE_TWO_FACTOR=false
